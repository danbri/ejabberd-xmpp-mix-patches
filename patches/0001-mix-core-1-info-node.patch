From 413e7faee111028b7630523db82f7812ae285261 Mon Sep 17 00:00:00 2001
From: Dan Brickley <danbri@danbri.org>
Date: Sun, 31 Aug 2026 14:00:00 +0100
Subject: [PATCH] mod_mix: repair MIX core:1/PAM join and info-node flows

The bundled codec handles MIX core:1, but mod_mix negotiated only the
messages and participants nodes. Current MIX clients normally request the
info node during join and retrieve it using PubSub. It also sends a
client-join result with a MIX core namespace in place of the original
MIX PAM namespace.

Add a minimal, read-only current channel information item and include the
node in subscription negotiation. The form intentionally exposes only the
stable, locally-known channel name; channel administration/configuration and
presence are outside this patch.
---
 src/mod_mix.erl     | 41 ++++++++++++++++++++++++++++++++++++++++-
 src/mod_mix_pam.erl | 19 ++++++++++---------
 2 files changed, 50 insertions(+), 10 deletions(-)

diff --git a/src/mod_mix.erl b/src/mod_mix.erl
index 132682f..caf107a 100644
--- a/src/mod_mix.erl
+++ b/src/mod_mix.erl
@@ -24,7 +24,7 @@
 -module(mod_mix).
 -behaviour(gen_mod).
 -behaviour(gen_server).
--protocol({xep, 369, '0.14.1', '16.03', "complete", ""}).
+-protocol({xep, 369, '0.14.6', '16.03', "complete", ""}).
 
 %% API
 -export([route/1]).
@@ -261,6 +261,10 @@ process_pubsub_query(#iq{type = get,
 			 sub_els = [#pubsub{items = #ps_items{node = Node}}]} = IQ)
   when Node == ?NS_MIX_NODES_PARTICIPANTS ->
     process_participants_list(IQ);
+process_pubsub_query(#iq{type = get,
+			 sub_els = [#pubsub{items = #ps_items{node = Node}}]} = IQ)
+  when Node == ?NS_MIX_NODES_INFO ->
+    process_info_node(IQ);
 process_pubsub_query(IQ) ->
     xmpp:make_error(IQ, unsupported_error(IQ)).
 
@@ -572,6 +576,39 @@ process_participants_list(#iq{from = From, to = To} = IQ) ->
 	    xmpp:make_error(IQ, db_error(IQ))
     end.

+-spec process_info_node(iq()) -> iq().
+process_info_node(#iq{from = From, to = To} = IQ) ->
+    {Chan, Host, _} = jid:tolower(To),
+    ServerHost = ejabberd_router:host_of_route(Host),
+    Mod = gen_mod:db_mod(ServerHost, ?MODULE),
+    BFrom = jid:remove_resource(From),
+    case Mod:get_channel(ServerHost, Chan, Host) of
+	{ok, _} ->
+	    case Mod:get_participant(ServerHost, Chan, Host, BFrom) of
+		{ok, _} ->
+		    Form = #xdata{type = result,
+				  fields = [#xdata_field{type = hidden,
+							       var = <<"FORM_TYPE">>,
+							       values = [?NS_MIX_CORE_1]},
+						    #xdata_field{var = <<"Name">>,
+							       values = [Chan]}]},
+		    Item = #ps_item{id = <<"current">>,
+					    sub_els = [xmpp:encode(Form)]},
+		    Pubsub = #pubsub{items = #ps_items{
+						     node = ?NS_MIX_NODES_INFO,
+						     items = [Item]}},
+		    xmpp:make_iq_result(IQ, Pubsub);
+		{error, notfound} ->
+		    xmpp:make_error(IQ, not_joined_error(IQ));
+		{error, db_failure} ->
+		    xmpp:make_error(IQ, db_error(IQ))
+	    end;
+	{error, notfound} ->
+	    xmpp:make_error(IQ, no_channel_error(IQ));
+	{error, db_failure} ->
+	    xmpp:make_error(IQ, db_error(IQ))
+    end.
+
 -spec items_of_participants([{jid(), binary(), binary()}]) -> [ps_item()].
 items_of_participants(Participants) ->
     lists:map(
@@ -584,7 +621,8 @@ items_of_participants(Participants) ->
 -spec known_nodes() -> [binary()].
 known_nodes() ->
     [?NS_MIX_NODES_MESSAGES,
-     ?NS_MIX_NODES_PARTICIPANTS].
+     ?NS_MIX_NODES_PARTICIPANTS,
+     ?NS_MIX_NODES_INFO].
 
 -spec filter_nodes([binary()]) -> [binary()].
 filter_nodes(Nodes) ->
diff --git a/src/mod_mix_pam.erl b/src/mod_mix_pam.erl
index 7ea8c5f..96f8eac 100644
--- a/src/mod_mix_pam.erl
+++ b/src/mod_mix_pam.erl
@@ -259,16 +259,17 @@ remove_user(LUser, LServer) ->
 -spec process_join(iq()) -> ignore.
 process_join(#iq{from = From, lang = Lang,
 		 sub_els = [#mix_client_join{channel = Channel,
-		                             join = Join}]} = IQ) ->
+		                             join = Join,
+		                             xmlns = PamNs}]} = IQ) ->
     ejabberd_router:route_iq(
       #iq{from = jid:remove_resource(From),
 	  to = Channel, type = set, sub_els = [Join]},
       fun(#iq{sub_els = [El]} = ResIQ) ->
         try xmpp:decode(El) of
             MixJoin ->
-                process_join_result(ResIQ#iq {
-                    sub_els = [MixJoin]
-                }, IQ)
+			    process_join_result(ResIQ#iq {
+				    sub_els = [MixJoin]
+				}, IQ, PamNs)
         catch
             _:{xmpp_codec, Reason} ->
                 Txt = xmpp:io_format_error(Reason),
@@ -293,10 +294,10 @@ process_leave(#iq{from = From,
 	    xmpp:make_error(IQ, db_error(IQ))
     end.
 
--spec process_join_result(iq(), iq()) -> ok.
+-spec process_join_result(iq(), iq(), binary()) -> ok.
 process_join_result(#iq{from = #jid{} = Channel,
-			type = result, sub_els = [#mix_join{id = ID, xmlns = XmlNs} = Join]},
-		    #iq{to = To} = IQ) ->
+			type = result, sub_els = [#mix_join{id = ID} = Join]},
+		    #iq{to = To} = IQ, PamNs) ->
     case add_channel(To, Channel, ID) of
 	ok ->
 	    % Do roster push
@@ -311,12 +312,12 @@ process_join_result(#iq{from = #jid{} = Channel,
 	    % send IQ result
 	    ChanID = make_channel_id(Channel, ID),
 	    Join1 = Join#mix_join{id = <<"">>, jid = ChanID},
-	    ResIQ = xmpp:make_iq_result(IQ, #mix_client_join{join = Join1, xmlns = XmlNs}),
+	    ResIQ = xmpp:make_iq_result(IQ, #mix_client_join{join = Join1, xmlns = PamNs}),
 	    ejabberd_router:route(ResIQ);
 	{error, db_failure} ->
 	    ejabberd_router:route_error(IQ, db_error(IQ))
     end;
-process_join_result(#iq{type = error} = Err, IQ) ->
+process_join_result(#iq{type = error} = Err, IQ, _PamNs) ->
     process_iq_error(Err, IQ).
 
 -spec process_leave_result(iq(), iq()) -> ok.
-- 
