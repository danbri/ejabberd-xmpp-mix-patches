+%%% 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+%%%-------------------------------------------------------------------
+-module(mod_mix_info_test).
+
+-include_lib("eunit/include/eunit.hrl").
+-include_lib("xmpp/include/xmpp.hrl").
+
+info_node_is_negotiable_test() ->
+    ?assert(lists:member(?NS_MIX_NODES_INFO, mod_mix:known_nodes())).
+
+existing_nodes_remain_negotiable_test() ->
+    Nodes = mod_mix:known_nodes(),
+    ?assert(lists:member(?NS_MIX_NODES_MESSAGES, Nodes)),
+    ?assert(lists:member(?NS_MIX_NODES_PARTICIPANTS, Nodes)).
+
+info_form_is_core_1_typed_test() ->
+    Creator = jid:make(<<"alice">>, <<"example.test">>),
+    #xdata{type = result, fields = Fields} =
+        mod_mix:info_node_form(<<"coven">>, Creator),
+    ?assertMatch(#xdata_field{type = hidden, values = [?NS_MIX_CORE_1]},
+                 field(<<"FORM_TYPE">>, Fields)).
+
+info_form_carries_name_and_contact_test() ->
+    Creator = jid:make(<<"alice">>, <<"example.test">>),
+    #xdata{fields = Fields} = mod_mix:info_node_form(<<"coven">>, Creator),
+    ?assertMatch(#xdata_field{values = [<<"coven">>]},
+                 field(<<"Name">>, Fields)),
+    ?assertMatch(#xdata_field{type = 'jid-multi',
+                              values = [<<"alice@example.test">>]},
+                 field(<<"Contact">>, Fields)).
+
+info_form_round_trips_through_codec_test() ->
+    Creator = jid:make(<<"alice">>, <<"example.test">>),
+    Form = mod_mix:info_node_form(<<"coven">>, Creator),
+    ?assertEqual(Form, xmpp:decode(xmpp:encode(Form))).
+
+field(Var, Fields) ->
+    case lists:keyfind(Var, #xdata_field.var, Fields) of
+        false -> {missing, Var};
+        Field -> Field
+    end.
