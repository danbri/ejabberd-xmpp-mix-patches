+		    #iq{to = To} = IQ, PamNs) ->
     case add_channel(To, Channel, ID) of
 	ok ->
 	    % Do roster push
@@ -311,12 +312,14 @@ process_join_result(#iq{from = #jid{} = Channel,
 	    % send IQ result
