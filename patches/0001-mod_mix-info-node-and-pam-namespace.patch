+    process_info_node(IQ);
 process_pubsub_query(IQ) ->
     xmpp:make_error(IQ, unsupported_error(IQ)).
 
@@ -572,6 +580,58 @@ process_participants_list(#iq{from = From, to = To} = IQ) ->
 	    xmpp:make_error(IQ, db_error(IQ))
     end.
 
+%% XEP-0369 section 6.1 shows the information node being read during
+%% channel discovery, before a join.  A channel that is not hidden therefore
+%% answers any requester; a hidden channel answers only its participants,
+%% which matches how the hidden flag already restricts disco#items.
+-spec process_info_node(iq()) -> iq().
+process_info_node(#iq{from = From, to = To} = IQ) ->
+    {Chan, Host, _} = jid:tolower(To),
+    ServerHost = ejabberd_router:host_of_route(Host),
+    Mod = gen_mod:db_mod(ServerHost, ?MODULE),
+    case Mod:get_channel(ServerHost, Chan, Host) of
+	{ok, {Creator, Hidden, _Key}} ->
+	    BFrom = jid:remove_resource(From),
+	    Allowed = case Hidden of
+			  false -> ok;
+			  true -> Mod:get_participant(ServerHost, Chan, Host, BFrom)
+		      end,
+	    case Allowed of
+		{error, notfound} ->
+		    xmpp:make_error(IQ, not_joined_error(IQ));
+		{error, db_failure} ->
+		    xmpp:make_error(IQ, db_error(IQ));
+		_ ->
+		    Item = #ps_item{id = <<"current">>,
+				    sub_els = [xmpp:encode(
+						 info_node_form(Chan, Creator))]},
+		    Pubsub = #pubsub{items = #ps_items{
+					       node = ?NS_MIX_NODES_INFO,
+					       items = [Item]}},
+		    xmpp:make_iq_result(IQ, Pubsub)
+	    end;
+	{error, notfound} ->
+	    xmpp:make_error(IQ, no_channel_error(IQ));
+	{error, db_failure} ->
+	    xmpp:make_error(IQ, db_error(IQ))
+    end.
+
+%% The information form defined in XEP-0369 section 6.1.  This module stores
+%% no channel description, so only the fields with stored values are emitted:
+%% Name is the channel localpart and Contact is the channel creator.
+-spec info_node_form(binary(), jid()) -> xdata().
+info_node_form(Chan, Creator) ->
+    #xdata{type = result,
+	   fields = [#xdata_field{type = hidden,
+				  var = <<"FORM_TYPE">>,
+				  values = [?NS_MIX_CORE_1]},
+		     #xdata_field{type = 'text-single',
+				  var = <<"Name">>,
+				  values = [Chan]},
+		     #xdata_field{type = 'jid-multi',
+				  var = <<"Contact">>,
+				  values = [jid:encode(Creator)]}]}.
+
 -spec items_of_participants([{jid(), binary(), binary()}]) -> [ps_item()].
 items_of_participants(Participants) ->
     lists:map(
@@ -584,7 +644,8 @@ items_of_participants(Participants) ->
 -spec known_nodes() -> [binary()].
 known_nodes() ->
     [?NS_MIX_NODES_MESSAGES,
-     ?NS_MIX_NODES_PARTICIPANTS].
+     ?NS_MIX_NODES_PARTICIPANTS,
+     ?NS_MIX_NODES_INFO].
 
 -spec filter_nodes([binary()]) -> [binary()].
 filter_nodes(Nodes) ->
