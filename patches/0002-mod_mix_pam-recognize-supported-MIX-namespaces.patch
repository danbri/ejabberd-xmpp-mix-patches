 src/mod_mix_pam.erl       | 15 ++++++++++-
 test/mod_mix_pam_test.erl | 53 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 67 insertions(+), 1 deletion(-)
 create mode 100644 test/mod_mix_pam_test.erl

diff --git a/src/mod_mix_pam.erl b/src/mod_mix_pam.erl
index 4184512..f7e5f4e 100644
--- a/src/mod_mix_pam.erl
+++ b/src/mod_mix_pam.erl
@@ -36,6 +36,10 @@
 	 webadmin_user/4,
 	 webadmin_menu_hostuser/4, webadmin_page_hostuser/4]).
 
+-ifdef(TEST).
+-export([has_mix_subtag/1]).
+-endif.
+
 -include_lib("xmpp/include/xmpp.hrl").
 -include("logger.hrl").
 -include("mod_roster.hrl").
@@ -150,7 +154,7 @@ mod_doc() ->
 bounce_sm_packet({_, #message{to = #jid{lresource = <<>>} = To,
 			      from = From,
 			      type = groupchat} = Msg} = Acc) ->
-    case xmpp:has_subtag(Msg, #mix{}) of
+    case has_mix_subtag(Msg) of
 	true ->
 	    {LUser, LServer, _} = jid:tolower(To),
 	    case get_channel(To, From) of
@@ -170,6 +174,15 @@ bounce_sm_packet({_, #message{to = #jid{lresource = <<>>} = To,
 bounce_sm_packet(Acc) ->
     Acc.
 
+-spec has_mix_subtag(message()) -> boolean().
+has_mix_subtag(Msg) ->
+    %% Keep matching the empty namespace used by mod_mix for locally built
+    %% records.  Also match explicit namespaces found on decoded stanzas:
+    %% Core:0 preserves wire compatibility and Core:1 handles current MIX.
+    xmpp:has_subtag(Msg, #mix{}) orelse
+    xmpp:has_subtag(Msg, #mix{xmlns = ?NS_MIX_CORE_0}) orelse
+    xmpp:has_subtag(Msg, #mix{xmlns = ?NS_MIX_CORE_1}).
+
 -spec disco_sm_features({error, stanza_error()} | empty | {result, [binary()]},
 			jid(), jid(), binary(), binary()) ->
 			       {error, stanza_error()} | empty | {result, [binary()]}.
