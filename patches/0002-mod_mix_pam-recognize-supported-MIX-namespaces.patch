+-module(mod_mix_pam_test).
+
+-include_lib("eunit/include/eunit.hrl").
+-include_lib("xmpp/include/xmpp.hrl").
+
+core_0_mix_subtag_test() ->
+    Msg = #message{sub_els = [#mix{xmlns = ?NS_MIX_CORE_0}]},
+    ?assert(mod_mix_pam:has_mix_subtag(Msg)).
+
+core_1_mix_subtag_test() ->
+    Msg = #message{sub_els = [#mix{xmlns = ?NS_MIX_CORE_1,
+                                  submission_id = <<"submission">>,
+                                  jid = jid:make(<<"alice">>, <<"example.test">>),
+                                  nick = <<"Alice">>}]},
+    %% This is the exact predicate used before the fix.  The empty namespace
+    %% in its template prevents it from matching the decoded Core:1 record.
+    ?assertNot(xmpp:has_subtag(Msg, #mix{})),
+    ?assert(mod_mix_pam:has_mix_subtag(Msg)).
+
+locally_built_mix_subtag_test() ->
+    Msg = #message{sub_els = [#mix{}]},
+    %% mod_mix builds this record in memory and routes it without a codec
+    %% round trip, so its namespace remains empty.  Preserve that existing
+    %% local-delivery path while adding explicit Core namespace support.
+    ?assert(xmpp:has_subtag(Msg, #mix{})),
+    ?assert(mod_mix_pam:has_mix_subtag(Msg)).
+
+unknown_mix_namespace_test() ->
+    Msg = #message{sub_els = [#mix{xmlns = <<"urn:example:not-mix">>}]},
+    ?assertNot(mod_mix_pam:has_mix_subtag(Msg)).
+
+non_mix_subtag_test() ->
+    Msg = #message{sub_els = [#delay{}]},
+    ?assertNot(mod_mix_pam:has_mix_subtag(Msg)).
