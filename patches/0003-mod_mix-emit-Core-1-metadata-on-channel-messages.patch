+-module(mod_mix_test).
+
+-include_lib("eunit/include/eunit.hrl").
+-include_lib("xmpp/include/xmpp.hrl").
+
+channel_mix_uses_core_1_test() ->
+    From = jid:make(<<"alice">>, <<"example.test">>),
+    ?assertMatch(#mix{xmlns = ?NS_MIX_CORE_1,
+                     jid = From,
+                     nick = <<"Alice">>},
+                 mod_mix:channel_mix(From, <<"Alice">>)).
+
+sender_channel_mix_preserves_submission_id_test() ->
+    From = jid:make(<<"alice">>, <<"example.test">>),
+    ?assertMatch(#mix{xmlns = ?NS_MIX_CORE_1,
+                     jid = From,
+                     nick = <<"Alice">>,
+                     submission_id = <<"submission-1">>},
+                 mod_mix:channel_mix(From, <<"Alice">>, <<"submission-1">>)).
